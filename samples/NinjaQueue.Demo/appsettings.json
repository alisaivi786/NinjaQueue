{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "Database": "PostgreSql",
    "TenantUserPassword": "demo-pass-123"
  },
  "ConnectionStrings": {
    "Demo": "Host=localhost;Port=5432;Database=ninjaqueue_demo;Username=postgres;Password=postgres"
  },
  "NinjaQueue": {
    "Schema": "ninjaqueue",
    "EnableRunningJobCancel": true,
    "Worker": {
      "Queues": { "default": 4, "email": 4, "payments": 2, "imports": 2, "reports": 1 },
      "PollInterval": "00:00:01"
    },
    "Retry": { "BaseDelay": "00:00:03", "MaxDelay": "00:00:20" },
    "Dashboard": {
      "Title": "NinjaQueue Demo",
      "Admin": { "UserName": "admin", "Password": "admin" }
    }
  }
}