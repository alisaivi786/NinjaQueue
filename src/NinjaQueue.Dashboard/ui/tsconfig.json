{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@shared": ["./src/shims/shared.ts"],
      "@ninja-icon": ["./src/shims/ninja-icon.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"]
    }
  },
  "include": ["src"]
}